{
  "name": "anikinghub",
  "productName": "AniKingHub",
  "private": true,
  "version": "1.1.0",
  "main": "electron.js",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "electron:dev": "electron .",
    "dist": "vite build && electron-builder --win nsis",
    "lint": "oxlint",
    "preview": "vite preview"
  },
  "build": {
    "appId": "com.anikinghub.app",
    "productName": "AniKingHub",
    "icon": "public/icon.ico",
    "publish": [
      {
        "provider": "github",
        "owner": "1Haritono",
        "repo": "Anime_app"
      }
    ],
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "AniKingHub"
    },
    "files": [
      "dist/**/*",
      "electron.js",
      "package.json"
    ],
    "directories": {
      "output": "dist_installer"
    },
    "npmRebuild": false
  },
  "dependencies": {
    "@capacitor/android": "^8.4.2",
    "@capacitor/cli": "^8.4.2",
    "@capacitor/core": "^8.4.2",
    "hls.js": "^1.6.16",
    "lucide": "^1.26.0",
    "lucide-react": "^1.26.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "webtorrent": "^3.0.16"
  },
  "devDependencies": {
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "electron": "^43.2.0",
    "electron-builder": "^26.15.3",
    "oxlint": "^1.71.0",
    "vite": "^8.1.1"
  }
}
